// ---------------------------------------------------------------
// ImpostorSolver.compute
// GPU-driven procedural instance solver for the LOD1+ impostor
// rendering pipeline.
//
// Three kernels, dispatched in order each frame:
//
//   1. CSVisibility
//      Replicates VisibilitySystem.ClassifyChunk on the GPU.
//
//   2. CSExpandBlotches
//      For each visible chunk: expands matching blotches into
//      individual instances via deterministic hash, competes
//      for grid cells via InterlockedOr, writes winners.
//
//   3. CSFillArgs
//      Reads per-bucket instance counts -> indirect draw args.
//
// All data structures must match BlotchTypes.cs, ImpostorRenderer.cs.
// ---------------------------------------------------------------

#pragma kernel CSVisibility
#pragma kernel CSExpandBlotches
#pragma kernel CSFillArgs

// =================================================================
// CONSTANTS
// =================================================================
#define FLAG_CULLOVERRIDE (1u << 24)
#define FLAG_ALWAYSINST   (1u << 25)
#define INST_PROTO_MASK   0xFFu
#define INST_LOD_SHIFT    8
#define INST_ROT_SHIFT    16
#define INST_SCALE_SHIFT  24
#define BITS_PER_CELL    4
#define CELLS_PER_UINT   8
#define SLAB_HEADER      4
#define MAX_VISIBLE 1024
#define MAX_BLOTCH_INST 4096
#define MAX_BUCKET_LODS 16
#define MAX_INSTANCES_PER_BUCKET 65536 

// =================================================================
// BUFFERS
// =================================================================
struct ChunkVisibilityData
{
    float centerDirX; float centerDirY; float centerDirZ;
    float cosThetaC; float sinThetaC;
    float boundCenterAlt; float boundHalfH;
    int chunkPacked;
};
StructuredBuffer<ChunkVisibilityData> _ChunkVisibilityBuffer;

struct BlotchData
{
    int chunkPacked; uint packedMeta; uint seedAndDensity; uint packedPos;
};
StructuredBuffer<BlotchData> _GlobalBlotchBuffer;

RWStructuredBuffer<uint> _VisibleChunkList;
RWStructuredBuffer<uint> _ChunkLODBuffer;
RWStructuredBuffer<uint> _ConflictGridArena;
StructuredBuffer<uint> _BucketMap;

struct InstanceData { float3 worldPos; uint packedMeta; uint seed; };
RWStructuredBuffer<InstanceData> _InstanceOutputBuffer;
RWStructuredBuffer<uint> _ArgsBuffer;

// AtomicCounters: [0] = instance count, [1+N] = per-bucket counts
RWStructuredBuffer<uint> _AtomicCounters;

float4 _FrustumPlanes[6];
float3 _CameraPos; float _PlayerAltitude;
float3 _SphereCenter; float _SphereRadius; float _HorizonMargin;
uint _MaxLODsPerBucket; uint _NumBuckets;
uint _MinX; uint _NumberOfChunks; uint _MapsPerFace;
uint _ResolutionPerLOD[8];
float _DensityMultiplierPerLOD[8];
float _WidthMultiplierPerLOD[8];
float _HalfChunkLinearSize;
uint _TotalBlotchCount; uint _SlabStride;
RWStructuredBuffer<uint> _VisibilityCount;
uint _TimeMS;
uint _DefaultChunkLOD;

// =================================================================
// HELPERS
// =================================================================
uint pcg_hash(uint input)
{
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> (int)((state >> 28) + 4u)) ^ state) * 277803737u;
    return (word >> 22) ^ word;
}

bool TestChunkHorizon(ChunkVisibilityData c, float3 pn, float cosP, float sinP)
{
    return dot(float3(c.centerDirX, c.centerDirY, c.centerDirZ), pn) >= cosP * c.cosThetaC - sinP * c.sinThetaC - _HorizonMargin;
}

bool TestSphereFrustum(float3 center, float radius)
{
    [unroll] for (int i = 0; i < 6; i++)
        if (dot(center, _FrustumPlanes[i].xyz) + _FrustumPlanes[i].w < -radius)
            return false;
    return true;
}

void BuildChunkSphere(ChunkVisibilityData c, out float3 center, out float radius)
{
    float sr = _SphereRadius + c.boundCenterAlt;
    center = _SphereCenter + float3(c.centerDirX, c.centerDirY, c.centerDirZ) * sr;
    float teq = 2.0 * _HalfChunkLinearSize * _HalfChunkLinearSize;
    radius = sqrt(teq + c.boundHalfH * c.boundHalfH) + 10.0;
}

uint UnpackProto(uint m)    { return (m >> 8) & 0xFFu; }
uint UnpackConflict(uint m) { return (m >> 16) & 0xFFu; }
bool UnpackAlwaysInst(uint m) { return (m & FLAG_ALWAYSINST) != 0; }

uint PackMeta(uint p, uint l, uint r, uint s)
{
    return (p & INST_PROTO_MASK) | ((l & 0xFFu) << INST_LOD_SHIFT)
         | ((r & 0xFFu) << INST_ROT_SHIFT) | ((s & 0xFFu) << INST_SCALE_SHIFT);
}

uint CellIdx(uint x, uint y, uint res) { return y * res + x; }

bool TryClaim(RWStructuredBuffer<uint> arena, uint slab, uint ci, uint want, uint forbid)
{
    uint off = SLAB_HEADER + ci / CELLS_PER_UINT;
    uint sh = (ci % CELLS_PER_UINT) * BITS_PER_CELL;
    uint addr = slab + off;
    uint mask = 0xFu << (int)sh;
    uint oldVal = arena[addr];
    uint cellVal = (oldVal >> (int)sh) & 0xFu;
    // If cell is occupied and the occupant's category is forbidden, reject
    // forbid bits align with category values: bit0=Grass(1), bit1=Canopy(2), bit2=Trunk(4)
    if (cellVal != 0 && (forbid & cellVal) != 0) return false;
    uint newVal = (oldVal & ~mask) | ((want << (int)sh) & mask);
    uint original;
    InterlockedCompareExchange(arena[addr], oldVal, newVal, original);
    return (original == oldVal);
}

float3 BlotchWorldPos(int chunkPacked, uint packedMeta, uint packedPos,
                      float lx, float lz,
                      float offsetAngle, float offsetDist)
{
    uint face = packedMeta & 0xFFu;
    // Unpack chunk coordinates — matches STPTMEUtils.WriteFourSBytesInInt:
    //   (mapX << 24) | (mapY << 16) | (chunkX << 8) | chunkY
    int mapX = (chunkPacked >> 24) & 0xFF;
    int mapY = (chunkPacked >> 16) & 0xFF;
    int chunkX = (chunkPacked >> 8) & 0xFF;
    int chunkY = chunkPacked & 0xFF;


    // Normalize to face UV space: total chunks per face edge = MapsPerFace * NumberOfChunks
    float globalLX = ((mapX - _MinX) * _NumberOfChunks + chunkX + lx) / (float)(_MapsPerFace * _NumberOfChunks);
    float globalLZ = ((mapY - _MinX) * _NumberOfChunks + chunkY + lz) / (float)(_MapsPerFace * _NumberOfChunks);

    float fx = globalLX - 0.5; 
    float fz = globalLZ - 0.5;

    float3 cp;
    if (face == 0) cp = float3(fx, 0.5, fz);
    else if (face == 1) cp = float3(fx, -0.5, fz);
    else if (face == 2) cp = float3(-0.5, fz, fx);
    else if (face == 3) cp = float3(0.5, fz, fx);
    else if (face == 4) cp = float3(fx, fz, 0.5);
    else cp = float3(fx, fz, -0.5);

    float3 dir = normalize(cp);
    float3 bp = _SphereCenter + dir * _SphereRadius;
    float3 rt = normalize(cross(dir, abs(dir.y) < 0.99 ? float3(0,1,0) : float3(1,0,0)));
    float3 ut = cross(dir, rt);
    float3 wp = bp + rt * cos(offsetAngle) * offsetDist + ut * sin(offsetAngle) * offsetDist;
    return _SphereCenter + normalize(wp - _SphereCenter) * _SphereRadius;
}

// =================================================================
// KERNEL 1: CSVisibility
// =================================================================
[numthreads(64, 1, 1)]
void CSVisibility(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    uint count, stride;
    _ChunkVisibilityBuffer.GetDimensions(count, stride);
    if (idx >= count) return;
    ChunkVisibilityData c = _ChunkVisibilityBuffer[idx];

    float h = max(_PlayerAltitude, 0.0);
    float cosP = _SphereRadius / (_SphereRadius + h);
    float sinP = sqrt(1.0 - cosP * cosP);
    float3 d = _CameraPos - _SphereCenter;
    float3 pn = length(d) > 1e-5 ? d / length(d) : float3(0,1,0);
    float3 center; float radius;
    BuildChunkSphere(c, center, radius);
    if (!TestChunkHorizon(c, pn, cosP, sinP)) return;
    if (!TestSphereFrustum(center, radius)) return;

    uint vi;
    InterlockedAdd(_VisibilityCount[0], 1, vi);
    if (vi < MAX_VISIBLE)
    {
        _VisibleChunkList[vi] = asuint(c.chunkPacked);
        _ChunkLODBuffer[vi] = _DefaultChunkLOD;
    }
}

// =================================================================
// KERNEL 2: CSExpandBlotches
// =================================================================
groupshared int gs_chunk; groupshared uint gs_slab;

[numthreads(256, 1, 1)]
void CSExpandBlotches(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint t = gtid.x;
    if (t == 0)
    {
        gs_chunk = gid.x < _VisibilityCount[0] ? (int)_VisibleChunkList[gid.x] : -1;
        gs_slab = gid.x * _SlabStride;
    }
    GroupMemoryBarrierWithGroupSync();
    if (gs_chunk < 0) return;

    uint chunkLOD = _ChunkLODBuffer[gid.x];
    uint res = _ResolutionPerLOD[min(chunkLOD, 7)];
    uint cellsUints = (res * res + CELLS_PER_UINT - 1) / CELLS_PER_UINT;
    
    if (t == 0)
    {
        _ConflictGridArena[gs_slab + 0] = _TimeMS;
        _ConflictGridArena[gs_slab + 1] = asuint(gs_chunk);
        _ConflictGridArena[gs_slab + 2] = cellsUints;
        _ConflictGridArena[gs_slab + 3] = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    // FIX: All threads must cooperate to zero out the grid cells for this slab!
    for (uint i = t; i < cellsUints; i += 256)
    {
        _ConflictGridArena[gs_slab + SLAB_HEADER + i] = 0;
    }
    GroupMemoryBarrierWithGroupSync();

    uint bpc = max(1u, (_TotalBlotchCount + 255) / 256);
    uint bs = t * bpc; uint be = min(bs + bpc, _TotalBlotchCount);

    [loop] for (uint bi = bs; bi < be; bi++)
    {
        BlotchData bl = _GlobalBlotchBuffer[bi];
        // Compare ONLY the map-level portion (bits 16-31): blotch chunkPacked was baked with
        // chunkX=0/chunkY=0 (cell-level), while the visible chunk has full coordinates.
        // Mask: 0xFFFF0000 isolates (mapX << 24) | (mapY << 16)
        uint blotchMapPart = asuint(bl.chunkPacked) & 0xFFFF0000u;
        uint chunkMapPart  = asuint(gs_chunk) & 0xFFFF0000u;
        if (blotchMapPart != chunkMapPart) continue;
        if (chunkLOD == 0 && !UnpackAlwaysInst(bl.packedMeta)) continue;

        float density = ((bl.seedAndDensity >> 16) & 0xFFu) * 0.5;
        float radius  = ((bl.seedAndDensity >> 24) & 0xFFu) * 0.25;
        uint protoIdx = UnpackProto(bl.packedMeta);
        uint conflict = UnpackConflict(bl.packedMeta);
        uint seed = bl.seedAndDensity & 0xFFFFu;
        float dm = _DensityMultiplierPerLOD[min(chunkLOD, 7)];
        float area = radius > 0.001 ? 3.14159 * radius * radius : 1.0;
        uint ic = radius < 0.001 ? 1 : min((uint)ceil(density * dm * area), MAX_BLOTCH_INST);
        uint forb = conflict == 1 ? 0x5u : (conflict == 2 ? 0x6u : 0x7u);

        [loop] for (uint inst = 0; inst < ic; inst++)
        {
            uint hi = (seed << 16) | (inst & 0xFFFFu);
            uint h1 = pcg_hash(hi); uint h2 = pcg_hash(h1 + 1);
            float ang = (h1 / 4294967296.0) * 6.283185;
            float dst = radius < 0.001 ? 0.0 : sqrt(h2 / 4294967296.0) * radius;

            // Extract the 0.0 to 1.0 local UV coordinates baked into the blotch
            float lx = (bl.packedPos & 0xFFFFu) / 65535.0;
            float lz = ((bl.packedPos >> 16) & 0xFFFFu) / 65535.0;

            float3 wp = BlotchWorldPos(gs_chunk, bl.packedMeta, bl.packedPos, lx, lz, ang, dst);

            // Map local UV to conflict grid resolution
            float cx = lx * res;
            float cy = lz * res;

            uint cxi = min((uint)max((int)cx, 0), res - 1);
            uint cyi = min((uint)max((int)cy, 0), res - 1);

            if (TryClaim(_ConflictGridArena, gs_slab, CellIdx(cxi, cyi, res), conflict, forb))
            {
                uint rotQ = (h1 >> 24) & 0xFFu;
                uint bucketIdx = _BucketMap[protoIdx * MAX_BUCKET_LODS + chunkLOD];
                if (bucketIdx != 0xFFFFFFFF)
                {
                    uint perBucketSlot;
                    InterlockedAdd(_AtomicCounters[1 + bucketIdx], 1, perBucketSlot);

                    // Per-bucket region: bucketIdx * MAX_INSTANCES_PER_BUCKET + perBucketSlot
                    uint globalSlot = bucketIdx * MAX_INSTANCES_PER_BUCKET + perBucketSlot;
                    _InstanceOutputBuffer[globalSlot].worldPos = wp;
                    _InstanceOutputBuffer[globalSlot].packedMeta = PackMeta(protoIdx, chunkLOD, rotQ, 128);
                    _InstanceOutputBuffer[globalSlot].seed = pcg_hash(hi + 9999);
                }
            }
        }
    }
}

// =================================================================
// KERNEL 3: CSFillArgs
// =================================================================
[numthreads(64, 1, 1)]
void CSFillArgs(uint3 id : SV_DispatchThreadID)
{
    uint b = id.x;
    if (b >= _NumBuckets) return;
    _ArgsBuffer[b * 5 + 1] = _AtomicCounters[1 + b];                    // instance count
    _ArgsBuffer[b * 5 + 4] = b * MAX_INSTANCES_PER_BUCKET;              // startInstance
}
